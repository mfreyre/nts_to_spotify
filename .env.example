# Spotify API Credentials
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback/

# YouTube API Credentials (optional - for YouTube playlist creation)
# Get these from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://127.0.0.1:4200/yt-callback

# Last.fm API Key (optional - for enrichment script)
# Get this from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
